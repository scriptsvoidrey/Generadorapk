# NEXA APK Studio - Environment Variables
# Copy to .env and edit as needed

# NextAuth secret (required)
NEXTAUTH_SECRET=

# App URL
NEXTAUTH_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Database (SQLite by default for local)
DATABASE_URL="file:./dev.db"

# Build driver: local (default) or github
BUILD_DRIVER=local

# Storage driver: local or vercel-blob
STORAGE_DRIVER=local

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub (only if BUILD_DRIVER=github)
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Android paths (set by setup-android.sh)
# ANDROID_HOME=
# JAVA_HOME=
# GRADLE_HOME=

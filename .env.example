# ── Base de datos ──────────────────────────────────────────────
# Por defecto SQLite (funciona localmente sin servicios externos).
# Para producción en Vercel usa Postgres (Vercel Postgres / Neon):
#   DATABASE_URL="postgres://user:pass@host:5432/nexa?sslmode=require"
#   y cambia provider a "postgresql" en prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# ── NextAuth ───────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-de-32-bytes"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opcional; si no se configuran, el botón de Google muestra aviso)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Pipeline de compilación APK (GitHub Actions) ───────────────
# Token con permisos "repo" y "workflow" (Settings > Developer settings > PAT).
GITHUB_TOKEN=""
# Repositorio donde vive el workflow .github/workflows/build-apk.yml, ej. "tu-usuario/nexa-apk-builder"
GITHUB_REPOSITORY=""
# ID o nombre del workflow, ej. "build-apk.yml"
GITHUB_WORKFLOW_ID="build-apk.yml"
# Rama por defecto del repo builder
GITHUB_DEFAULT_BRANCH="main"
# Secreto compartido que el workflow usa para devolver el APK y el estado al backend.
# Genera con: openssl rand -hex 32
BUILD_CALLBACK_SECRET=""

# ── Almacenamiento y límites ───────────────────────────────────
# "local" (por defecto) o "vercel-blob"
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""
MAX_UPLOAD_MB="50"
# URL pública base que el runner de GitHub usa para descargar el fuente.
# En local GitHub no puede alcanzar localhost: usa ngrok o despliega en Vercel.
PUBLIC_BASE_URL="http://localhost:3000"

# ── Driver de compilación (local por defecto, sin GitHub) ─────────────
# "local"  (por defecto): compila el APK en esta misma máquina. Requiere
#          Android SDK + JDK 17 + Gradle; instálalos una vez con:
#              bash scripts/setup-android.sh
# "github": compila vía GitHub Actions (solo recomendado en Vercel/serverless,
#          donde no hay Android SDK ni disco persistente). Requiere
#          GITHUB_TOKEN, GITHUB_REPOSITORY y PUBLIC_BASE_URL alcanzable.
BUILD_DRIVER="local"

# Las siguientes variables las escribe automáticamente scripts/setup-android.sh
# (no las edites a mano salvo que sepas lo que haces):
# ANDROID_HOME="$HOME/.nexa/android-sdk"
# JAVA_HOME="$HOME/.nexa/jdk-17"
# GRADLE_HOME="$HOME/.nexa/gradle-8.7"
